  ],
  "calendar": [
    "GOOGLE",
    "https://accounts.google.com/o/oauth2/v2/auth",
    "https://oauth2.googleapis.com/token",
    "openid email profile https://www.googleapis.com/auth/calendar"
  ],
  "docs": [
    "GOOGLE",
    "https://accounts.google.com/o/oauth2/v2/auth",
    "https://oauth2.googleapis.com/token",
    "openid email profile https://www.googleapis.com/auth/documents"
  ],
  "sheets": [
    "GOOGLE",
    "https://accounts.google.com/o/oauth2/v2/auth",
