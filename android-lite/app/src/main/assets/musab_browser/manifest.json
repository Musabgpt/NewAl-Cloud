{
  "manifest_version": 2,
  "name": "MusabAI page reader",
  "version": "1.1",
  "description": "Reads and acts on the page in MusabAI's hidden browser for its agent (HeadlessBrowser.java). Bump the version when content.js changes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@musabai.newal"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
