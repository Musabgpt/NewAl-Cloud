{
  "problemMatcher": [
    {
      "owner": "musabai-javac",
      "pattern": [
        {"regexp": "^(.+\\.java):(\\d+): error: (.+)$", "file": 1, "line": 2, "message": 3}
      ]
    },
    {
      "owner": "musabai-gradle",
      "severity": "error",
      "pattern": [
        {"regexp": "^\\* What went wrong:$"},
        {"regexp": "^(.+)$", "message": 1}
      ]
    },
    {
      "owner": "musabai-gradle-cause",
      "severity": "error",
      "pattern": [
        {"regexp": "^\\s+> (.+)$", "message": 1}
      ]
    },
    {
      "owner": "musabai-aar-metadata",
      "severity": "error",
      "pattern": [
        {"regexp": "^\\s+\\d+\\.\\s+(Dependency .+)$", "message": 1}
      ]
    }
  ]
}
